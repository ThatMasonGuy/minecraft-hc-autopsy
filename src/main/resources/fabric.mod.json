{
	"schemaVersion": 1,
	"id": "hc-autopsy",
	"version": "${version}",
	"name": "HC Autopsy",
	"description": "Capture Hardcore world wipes, full player stat snapshots, and lifetime run history on Fabric servers.",
	"authors": [
		"Tempest Studios"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/hc-autopsy",
		"sources": "https://github.com/ThatMasonGuy/minecraft-hc-autopsy"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/hc-autopsy/icon.png",
	"environment": "server",
	"entrypoints": {
		"main": [
			"tempeststudios.hcautopsy.HCAutopsy"
		]
	},
	"mixins": [
		"hc-autopsy.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
